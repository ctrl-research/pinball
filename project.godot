[physics]

; 120Hz, not 60. This is the single most important setting in the project: at
; 60Hz a ball moving 600px/s advances 10px per tick, which is wider than the
; ball and comparable to the thickness of a wall, so contacts are missed and
; flipper sweeps pass straight through. Everything else here is taste; this one
; is correctness.
common/physics_ticks_per_second=120
; A real table is inclined ~6.5 degrees, so in-plane acceleration is
; g*sin(6.5) ~= 1.11 m/s^2. A 42" playfield mapped to 344px is ~322 px/m, so a
; faithful value would be ~357 px/s^2. We run faster than real because a
; correctly-inclined table feels sluggish on a screen.
2d/default_gravity=480.0

[rendering]

; Required for the universal (arm64 + x86_64) macOS export -- Godot refuses to
; build for arm64 without it. This project has almost no textures to compress,
; so it costs nothing here.
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.043, 0.039, 0.063, 1)
